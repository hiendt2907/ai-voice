# Copy this to secrets.yaml and fill in real values.
# DO NOT commit secrets.yaml — it's in .gitignore.
apiVersion: v1
kind: Secret
metadata:
  name: ai-voice-secrets
  namespace: ai-voice
type: Opaque
stringData:
  JWT_SECRET: "change-me-in-production"
  JWT_REFRESH_SECRET: "change-me-refresh"
  MINIO_ACCESS_KEY: "minioadmin"
  MINIO_SECRET_KEY: "minioadmin"
  CLOUDFONE_AUTH_USER: ""
  CLOUDFONE_AUTH_KEY: ""
  DOCTORCHECK_API_KEY: ""
