# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aivoice
REDIS_URL=redis://localhost:6379

# ─── Object Storage (MinIO) ────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=recordings

# ─── NestJS API ────────────────────────────────────────────
API_PORT=3001
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh

# ─── Next.js Portal ────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001

# ─── Python Voice Worker ───────────────────────────────────
VOICE_PORT=8000
NESTJS_WEBHOOK_URL=http://localhost:3001/internal/call-events

# ─── CloudFone (ODS) ───────────────────────────────────────
CLOUDFONE_WS_URL=
CLOUDFONE_SERVICE_NAME=
CLOUDFONE_AUTH_USER=
CLOUDFONE_AUTH_KEY=

# ─── DoctorCheck Backend ───────────────────────────────────
DOCTORCHECK_API_URL=https://www.doctorcheck.vn/api
DOCTORCHECK_API_KEY=
