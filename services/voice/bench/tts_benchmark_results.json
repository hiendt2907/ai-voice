{
  "sentences": [
    {
      "id": "s01",
      "category": "script",
      "text": "Dạ, Doctor Check xin nghe ạ. Em có thể hỗ trợ gì cho anh chị ạ?"
    },
    {
      "id": "s02",
      "category": "script",
      "text": "Dạ anh chị muốn đặt lịch khám hay cần hỗ trợ gì ạ?"
    },
    {
      "id": "s03",
      "category": "script",
      "text": "Dạ em có thể hỗ trợ đặt lịch khám, hoặc trả lời thắc mắc về dịch vụ ạ."
    },
    {
      "id": "s04",
      "category": "script",
      "text": "Anh chị có thể nói ví dụ: tám giờ sáng, hoặc ba giờ chiều ạ."
    },
    {
      "id": "s05",
      "category": "script",
      "text": "Dạ, anh chị giữ máy giúp em, để em kiểm tra chính xác giờ cho mình ạ."
    },
    {
      "id": "s06",
      "category": "script",
      "text": "Dạ, hiện tại chín giờ ba mươi sáng ngày hai mươi lăm tháng mười hai phòng khám vẫn còn trống lịch ạ, em đặt luôn cho mình nhé?"
    },
    {
      "id": "s07",
      "category": "script",
      "text": "Dạ, em nhận thông tin rồi ạ, em xin xác nhận lại. Anh chị Nguyễn Văn Bảy, số điện thoại 0903 456 789, đặt lịch khám vào chín giờ sáng ngày mười lăm tháng mười một."
    },
    {
      "id": "s08",
      "category": "script",
      "text": "Dạ, em đặt lịch cho mình xong rồi ạ. Phòng khám sẽ nhắn tin xác nhận lịch hẹn tới số 0903 456 789 trước ngày khám ạ."
    },
    {
      "id": "s09",
      "category": "script",
      "text": "Dạ, em cảm ơn anh chị. Doctor Check rất vui được tiếp đón anh chị vào buổi sáng ngày mai ạ. Chúc anh chị sức khỏe ạ."
    },
    {
      "id": "s10",
      "category": "script",
      "text": "Dạ để tra cứu kết quả xét nghiệm, em xin phép chuyển anh chị sang nhân viên chuyên trách ạ. Anh chị vui lòng giữ máy giây lát ạ."
    },
    {
      "id": "s11",
      "category": "numbers",
      "text": "Anh Nguyễn Văn Bảy có lịch khám lúc 9 giờ 30 sáng ngày 25 tháng 12."
    },
    {
      "id": "s12",
      "category": "numbers",
      "text": "Số điện thoại của chị là không chín không ba, bốn năm sáu, bảy tám chín."
    },
    {
      "id": "s13",
      "category": "numbers",
      "text": "Tổng chi phí gói khám là 1.250.000 đồng, đã bao gồm phí xét nghiệm ạ."
    },
    {
      "id": "s14",
      "category": "numbers",
      "text": "Lịch trống còn thứ Ba ngày 15 tháng 11, lúc 8 giờ 15 và 10 giờ 45 ạ."
    },
    {
      "id": "s15",
      "category": "numbers",
      "text": "Hai mươi mốt, hai mươi lăm, một trăm lẻ một, một nghìn không trăm ba mươi tư."
    },
    {
      "id": "s16",
      "category": "tones",
      "text": "Mốt hay một, sáu hay sáo, chín hay chin, ngã hay ngả, hỏi hay hỏng ạ?"
    },
    {
      "id": "s17",
      "category": "tones",
      "text": "Bác sĩ Lê Thị Hoài Mỹ khám tại phòng khám Quận Phú Nhuận, đường Nguyễn Văn Trỗi, thành phố Hồ Chí Minh."
    },
    {
      "id": "s18",
      "category": "loanword",
      "text": "Anh chị vui lòng check-in tại quầy lễ tân, chọn combo tầm soát Doctor Check Premium, rồi scan mã QR ạ."
    }
  ],
