{
  "id": "00000000-0000-0000-0000-000000000002",
  "version": "2.0.0",
  "campaign_id": "00000000-0000-0000-0000-000000000010",
  "direction": "inbound",
  "voice_profile": "linh_clone_v1",
  "entry_step": "greeting",
  "slot_autofill": true,
  "notes": "v2: Multi-RAG, slot-autofill, availability-driven, inquiry-first support",
  "steps": [
    {
      "id": "greeting",
      "type": "speak_listen",
      "slot_autofill": true,
      "variants": [
        {
          "id": "v1",
          "beats": [
            {"text": "Xin chào,", "pause_after": "breath"},
            {"text": "đây là tổng đài DoctorCheck.", "pause_after": "medium"},
            {"text": "Tôi là Linh,", "pause_after": "short"},
            {"text": "rất vui được hỗ trợ bạn hôm nay.", "pause_after": "medium"},
            {"text": "Bạn cần đặt lịch khám, hỏi thông tin dịch vụ, hay có việc gì khác ạ?", "pause_after": "turn"}
