      "transitions": [
        {"when": "intent == 'confirm' && slot.specialty != null", "goto": "collect_name"},
        {"when": "intent == 'confirm'", "goto": "collect_name"},
        {"when": "intent == 'deny'", "goto": "collect_specialty"},
        {"when": "slot.specialty != null", "goto": "collect_name"}
      ],
      "fallback_goto": "handoff_to_staff",
      "max_no_match": 2
    },

    {
      "id": "answer_service_question",
      "type": "speak_listen",
      "slot_autofill": true,
      "rag_queries": [
        {
          "id": "service_info",
          "template": "thông tin dịch vụ {{slot.specialty}} tại DoctorCheck giá thời gian yêu cầu",
          "tags": ["services", "pricing"],
          "bind_to": "rag.service_info"
        }
      ],
      "variants": [
        {
          "id": "v1",
          "beats": [
            {"text": "{{rag.service_info.summary}}", "pause_after": "long"},
            {"text": "Bạn còn muốn hỏi thêm gì không,", "pause_after": "short"},
            {"text": "hay bạn muốn đặt lịch luôn ạ?", "pause_after": "turn"}
          ]
        },
        {
          "id": "v_no_rag",
          "condition": "rag.service_info == null",
          "beats": [
            {"text": "Để tư vấn chính xác hơn về dịch vụ bạn cần,", "pause_after": "short"},
            {"text": "tôi xin chuyển bạn sang nhân viên chuyên trách ạ.", "pause_after": "turn"}
          ]
        }
      ],
      "reprompt_variants": [
        {
          "id": "r1",
          "beats": [
            {"text": "Bạn có muốn đặt lịch khám không ạ?", "pause_after": "turn"}
          ]
        },
        {
          "id": "r2",
          "beats": [
            {"text": "Tôi có thể hỗ trợ đặt lịch hoặc chuyển bạn tới nhân viên ạ.", "pause_after": "turn"}
          ]
        }
      ],
      "transitions": [
