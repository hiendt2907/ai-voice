      ],
      "variants": [
        {
          "id": "v1",
          "beats": [
            {"text": "Dựa vào triệu chứng bạn mô tả,", "pause_after": "short"},
            {"text": "{{rag.suggested_specialty.summary}}", "pause_after": "medium"},
            {"text": "Bạn có muốn đặt lịch khám chuyên khoa này không ạ?", "pause_after": "turn"}
          ]
        },
        {
          "id": "v_no_rag",
          "condition": "rag.suggested_specialty == null",
          "beats": [
            {"text": "Tôi hiểu rồi.", "pause_after": "short"},
            {"text": "Để được tư vấn chính xác hơn, bạn muốn đặt khám tổng quát trước hay chuyên khoa cụ thể ạ?", "pause_after": "turn"}
          ]
        }
      ],
      "reprompt_variants": [
        {
          "id": "r1",
          "beats": [
            {"text": "Bạn có muốn đặt khám không ạ?", "pause_after": "medium"},
            {"text": "Nói có để tôi tiếp tục, hoặc cho tôi biết chuyên khoa bạn muốn.", "pause_after": "turn"}
          ]
        },
        {
          "id": "r2",
          "beats": [
            {"text": "Tôi chuyển bạn sang nhân viên để tư vấn chi tiết hơn nhé ạ.", "pause_after": "turn"}
