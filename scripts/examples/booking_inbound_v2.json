          "when": "(intent == 'book_appointment' || intent == 'confirm') && slot.specialty != null && slot.patient_name != null && slot.appointment_date != null",
          "goto": "check_availability"
        },
        {
          "when": "(intent == 'book_appointment' || intent == 'confirm') && slot.specialty != null",
