        },
        {"when": "intent == 'book_appointment' || intent == 'confirm'", "goto": "collect_specialty"},
        {"when": "intent == 'ask_price'", "goto": "answer_service_question"},
        {"when": "intent == 'deny' || intent == 'no_booking'", "goto": "closing_no_booking"},
        {"when": "intent == 'speak_to_staff'", "goto": "handoff_to_staff"}
