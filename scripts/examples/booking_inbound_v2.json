        }
      ],
      "reprompt_variants": [
        {
          "id": "r1",
          "beats": [
            {"text": "Tôi có thể hỗ trợ đặt lịch khám,", "pause_after": "short"},
            {"text": "tư vấn về các dịch vụ,", "pause_after": "short"},
            {"text": "tra cứu kết quả, hoặc hủy lịch ạ.", "pause_after": "turn"}
          ]
        },
        {
          "id": "r2",
          "beats": [
            {"text": "Bạn có muốn đặt lịch khám không ạ?", "pause_after": "turn"}
          ]
        },
        {
          "id": "r3",
          "beats": [
            {"text": "Tôi xin chuyển bạn tới nhân viên hỗ trợ trực tiếp ạ.", "pause_after": "turn"}
          ]
        }
      ],
      "transitions": [
        {"when": "intent == 'service_inquiry' || intent == 'ask_price' || intent == 'ask_prep'", "goto": "answer_service_question"},
        {"when": "intent == 'symptom_described'", "goto": "suggest_specialty"},
        {"when": "intent == 'check_result'", "goto": "check_result"},
        {"when": "intent == 'cancel_appointment'", "goto": "handle_cancel"},
        {"when": "intent == 'speak_to_staff'", "goto": "handoff_to_staff"},
        {
          "when": "(intent == 'book_appointment') && slot.specialty != null && slot.patient_name != null && slot.appointment_date != null",
          "goto": "check_availability",
          "note": "Khách nói 1 câu đủ thông tin — bỏ qua các bước collect"
        },
        {
          "when": "(intent == 'book_appointment') && slot.specialty != null && slot.patient_name != null",
          "goto": "collect_date"
        },
        {
          "when": "(intent == 'book_appointment') && slot.specialty != null",
          "goto": "collect_name"
        },
        {"when": "intent == 'book_appointment'", "goto": "collect_specialty"}
      ],
      "fallback_goto": "handoff_to_staff",
      "max_no_match": 3
    },

    {
