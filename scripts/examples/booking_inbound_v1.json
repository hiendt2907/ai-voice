  "entry_step": "greeting",
  "steps": [
    {
      "id": "greeting",
      "type": "speak_listen",
      "variants": [
        {
          "id": "v1",
          "beats": [
            {"text": "Xin chào,", "pause_after": "breath"},
            {"text": "đây là tổng đài đặt lịch khám của phòng khám DoctorCheck.", "pause_after": "medium"},
            {"text": "Tôi là Linh,", "pause_after": "short"},
            {"text": "rất vui được hỗ trợ bạn.", "pause_after": "medium"},
            {"text": "Bạn muốn đặt lịch khám hay cần hỗ trợ gì ạ?", "pause_after": "turn"}
          ]
        }
      ],
      "reprompt_variants": [
        {
          "id": "r1",
          "beats": [
            {"text": "Bạn có muốn đặt lịch khám không ạ?", "pause_after": "turn"}
          ]
        },
        {
          "id": "r2",
          "beats": [
            {"text": "Tôi có thể hỗ trợ đặt lịch khám,", "pause_after": "short"},
            {"text": "tra cứu kết quả xét nghiệm,", "pause_after": "short"},
            {"text": "hoặc hủy lịch hẹn ạ.", "pause_after": "turn"}
          ]
        },
        {
          "id": "r3",
          "beats": [
            {"text": "Nếu bạn cần hỗ trợ,", "pause_after": "short"},
            {"text": "tôi có thể kết nối tới nhân viên trực tiếp cho bạn ạ.", "pause_after": "turn"}
          ]
        }
      ],
      "transitions": [
        {"when": "intent == 'book_appointment'", "goto": "collect_specialty"},
        {"when": "intent == 'check_result'", "goto": "check_result"},
        {"when": "intent == 'cancel_appointment'", "goto": "handle_cancel"},
        {"when": "intent == 'speak_to_staff'", "goto": "handoff_to_staff"}
      ],
      "fallback_goto": "handoff_to_staff",
      "max_no_match": 3
    },
    {
      "id": "collect_specialty",
      "type": "speak_listen",
      "variants": [
        {
          "id": "v1",
          "beats": [
            {"text": "Bạn muốn khám chuyên khoa gì ạ?", "pause_after": "medium"},
