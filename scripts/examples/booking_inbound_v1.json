        },
        {
          "id": "r3",
          "beats": [
            {"text": "Để thuận tiện hơn,", "pause_after": "short"},
            {"text": "tôi xin chuyển bạn tới nhân viên để hỗ trợ trực tiếp ạ.", "pause_after": "turn"}
