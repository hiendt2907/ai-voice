      ],
      "reprompt_variants": [
        {
          "id": "r1",
          "beats": [
            {"text": "Xin lỗi, tôi chưa nghe rõ.", "pause_after": "short"},
            {"text": "Bạn muốn khám chuyên khoa nào ạ?", "pause_after": "turn"}
          ]
        },
        {
          "id": "r2",
          "beats": [
            {"text": "Ví dụ bạn có thể nói:", "pause_after": "short"},
            {"text": "nội khoa, tim mạch, da liễu, nha khoa, sản phụ khoa, hoặc khám tổng quát ạ.", "pause_after": "turn"}
